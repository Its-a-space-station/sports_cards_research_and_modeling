b-images/image/upload/t_16x9/w_640/q_auto/mlb/omjhf6qel4500etrx6fd&quot;,&quot;title&quot;:&quot;Alfred Morillo seals Texas League championship&quot;,&quot;relativeSiteUrl&quot;:&quot;/video/alfred-morillo-seals-texas-league-championship&quot;,&quot;id&quot;:&quot;dd349954-9e69-4382-bf71-07240f5e7dee&quot;},&quot;Video:1046c7ac-4661-4156-80ec-4495a803d574&quot;:{&quot;__typename&quot;:&quot;Video&quot;,&quot;contentDate&quot;:&quot;2026-09-24T03:23:44.947Z&quot;,&quot;duration&quot;:&quot;00:00:33&quot;,&quot;translationId&quot;:&quot;1046c7ac-4661-4156-80ec-4495a803d574&quot;,&quot;slug&quot;:&quot;james-tibbs-iii-homers-2-on-a-fly-ball-to-center-field-zach-ehrhard-score&quot;,&quot;formattedThumbnail({\&quot;aspectRatio\&quot;:\&quot;16:9\&quot;,\&quot;width\&quot;:640})&quot;:&quot;https://img.mlbstatic.com/mlb-images/image/upload/t_16x9/w_640/q_auto/mlb/u1acoye50dsiggot07a9&quot;,&quot;title&quot;:&quot;James Tibbs III&#x27;s three-run home run&quot;,&quot;relativeSiteUrl&quot;:&quot;/video/james-tibbs-iii-homers-2-on-a-fly-ball-to-center-field-zach-ehrhard-score&quot;,&quot;id&quot;:&quot;1046c7ac-4661-4156-80ec-4495a803d574&quot;},&quot;Video:272dd683-1162-4720-830c-821d7af3569c&quot;:{&quot;__typename&quot;:&quot;Video&quot;,&quot;contentDate&quot;:&quot;2026-09-24T03:17:56.791Z&quot;,&quot;duration&quot;:&quot;00:00:35&quot;,&quot;translationId&quot;:&quot;272dd683-1162-4720-830c-821d7af3569c&quot;,&quot;slug&quot;:&quot;austin-gordon-fans-10-over-6-1-3-innings-of-game-3&quot;,&quot;formattedThumbnail({\&quot;aspectRatio\&quot;:\&quot;16:9\&quot;,\&quot;width\&quot;:640})&quot;:&quot;https://img.mlbstatic.com/mlb-images/image/upload/t_16x9/w_640/q_auto/mlb/jkohirsdbmpnl7brhxbn&quot;,&quot;title&quot;:&quot;Austin Gordon fans 10 over 6 1/3 innings of game 3&quot;,&quot;relativeSiteUrl&quot;:&quot;/video/austin-gordon-fans-10-over-6-1-3-innings-of-game-3&quot;,&quot;id&quot;:&quot;272dd683-1162-4720-830c-821d7af3569c&quot;},&quot;Video:03109d3f-4744-4398-b8c2-