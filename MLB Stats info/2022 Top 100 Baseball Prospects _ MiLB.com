t;id&quot;:138,&quot;name&quot;:&quot;St. Louis Cardinals&quot;,&quot;parentOrgId&quot;:null,&quot;parentOrgName&quot;:null,&quot;sport&quot;:{&quot;__ref&quot;:&quot;Sport:1&quot;}},&quot;Team:109&quot;:{&quot;__typename&quot;:&quot;Team&quot;,&quot;id&quot;:109,&quot;name&quot;:&quot;Arizona Diamondbacks&quot;,&quot;parentOrgId&quot;:null,&quot;parentOrgName&quot;:null,&quot;sport&quot;:{&quot;__ref&quot;:&quot;Sport:1&quot;}},&quot;Team:108&quot;:{&quot;__typename&quot;:&quot;Team&quot;,&quot;id&quot;:108,&quot;name&quot;:&quot;Los Angeles Angels&quot;,&quot;parentOrgId&quot;:null,&quot;parentOrgName&quot;:null,&quot;sport&quot;:{&quot;__ref&quot;:&quot;Sport:1&quot;}},&quot;Team:119&quot;:{&quot;__typename&quot;:&quot;Team&quot;,&quot;id&quot;:119,&quot;name&quot;:&quot;Los Angeles Dodgers&quot;,&quot;parentOrgId&quot;:null,&quot;parentOrgName&quot;:null,&quot;sport&quot;:{&quot;__ref&quot;:&quot;Sport:1&quot;}},&quot;Team:137&quot;:{&quot;__typename&quot;:&quot;Team&quot;,&quot;id&quot;:137,&quot;name&quot;:&quot;San Francisco Giants&quot;,&quot;parentOrgId&quot;:null,&quot;parentOrgName&quot;:null,&quot;sport&quot;:{&quot;__ref&quot;:&quot;Sport:1&quot;}},&quot;Sport:1&quot;:{&quot;__typename&quot;:&quot;Sport&quot;,&quot;abbreviation&quot;:&quot;MLB&quot;,&quot;id&quot;:&quot;1&quot;},&quot;Team:118&quot;:{&quot;__typename&quot;:&quot;Team&quot;,&quot;id&quot;:118,&quot;name&quot;:&quot;Kansas City Royals&quot;,&quot;parentOrgId&quot;:null,&quot;parentOrgName&quot;:null,&quot;sport&quot;:{&quot;__ref&quot;:&quot;Sport:1&quot;}},&quot;DraftTeam:118&quot;:{&quot;__typename&quot;:&quot;DraftTeam&quot;,&quot;id&quot;:118},&quot;Person:677951&quot;:{&quot;__typename&quot;:&quot;Person&quot;,&quot;batSideCode&quot;:&quot;R&quot;,&quot;birthCity&quot;:&quot;Colleyville&quot;,&quot;birthCountry&quot;:&quot;USA&quot;,&quot;birthDate&quot;:&quot;2000-06-14&quot;,&quot;boxscoreName&quot;:&quot;Witt Jr.&quot;,&quot;currentAge&quot;:26,&quot;activeRoster&quot;:{&quot;__re